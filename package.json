{
  "name": "nextbrowser",
  "version": "0.2.59",
  "description": "NextBrowser desktop agent console for macOS and Windows",
  "author": "NextBrowser",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --port 1421\" \"wait-on tcp:1421 && cross-env VITE_DEV_SERVER_URL=http://localhost:1421 electron .\"",
    "build": "npm run validate:skills && tsc && vite build",
    "postinstall": "electron-builder install-app-deps && node scripts/ensure-pty-helper.cjs",
    "test": "vitest run --exclude \"**/*.test.cjs\" && node scripts/test-node.mjs && node scripts/verify-pty.cjs",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir -c.mac.identity=-",
    "dist": "npm run build && electron-builder --publish never",
    "dist:publish": "npm run build && electron-builder --publish always",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "icons": "node scripts/generate-icons.mjs",
    "validate:skills": "node scripts/validate-skills.mjs",
    "test:critical": "node scripts/test-critical.mjs"
  },
  "dependencies": {
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@nextbrowser-oss/x-monitoring": "github:nextbrowser-oss/nextbrowser-x-monitoring#3dba263278d4627b61131d7fbd88ff620808fb3b",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.22.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.2",
    "vite": "^8.1.2",
    "vitest": "^4.1.9",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.nextbrowser.desktop",
    "productName": "NextBrowser",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "nextbrowser-oss",
        "repo": "nextbrowser-app"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "artifactName": "NextBrowser-${version}-${arch}.${ext}",
    "protocols": [
      {
        "name": "NextBrowser Auth",
        "schemes": [
          "nextbrowser"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
