{"apiVersion":1,"id":"kanban","name":"Kanban","version":"1.0.0","description":"Organize your tasks across To do, In progress and Done.","permissions":["storage"],"html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Kanban</title><style>:root { color-scheme: light dark; font: 14px/1.45 system-ui, sans-serif; --ink: #232b3a; --paper: #fbfaf7; --lane: #f0efeb; --card: #fff; --line: #d5d4ce; --accent: #3b50bb; }\n@media (prefers-color-scheme: dark) { :root { --ink: #eef1f8; --paper: #20242b; --lane: #292f38; --card: #343e4c; --line: #4b586a; --accent: #b9bdff; } }\n* { box-sizing: border-box; }\nbody { margin: 0; background: var(--paper); color: var(--ink); }\nmain { padding: clamp(14px, 2.4vw, 32px); }\nheader, footer, .lane-heading, .actions { display: flex; align-items: center; justify-content: space-between; gap: 8px; }\nh1, h2, p { margin: 0; }\nh1 { font-size: 24px; letter-spacing: -.04em; }\nh2 { font-size: 15px; }\n#counts, .empty, .lane-heading span { opacity: .74; }\n#notice:not(:empty) { margin: 12px 0; }\n#columns { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin-top: 20px; }\n.lane { padding: 12px; border-radius: 12px; background: var(--lane); min-height: 180px; }\n.lane-heading { justify-content: flex-start; margin-bottom: 12px; border-top: 3px solid #848cae; padding-top: 9px; }\n.lane:nth-child(2) .lane-heading { border-color: #cc9440; } .lane:nth-child(3) .lane-heading { border-color: #579f85; }\n.card { overflow-wrap: anywhere; padding: 10px; margin-bottom: 8px; border: 1px solid var(--line); border-radius: 8px; background: var(--card); }\n.card p { margin: 6px 0; white-space: pre-wrap; }\n.actions { flex-wrap: wrap; justify-content: flex-start; margin-top: 8px; }\nbutton, input, select, textarea { font: inherit; color: inherit; background: var(--card); border: 1px solid var(--line); border-radius: 6px; padding: 5px 9px; }\nbutton { cursor: pointer; } button:hover { border-color: var(--accent); }\nbutton:focus-visible, select:focus-visible, input:focus-visible, textarea:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\nbutton:disabled { opacity: .55; cursor: default; }\n.actions button { font-size: 12px; }\ndialog { width: min(92vw, 380px); background: var(--paper); color: var(--ink); border: 1px solid var(--line); border-radius: 12px; padding: 20px; }\ndialog::backdrop { background: #0007; }\nform, label { display: grid; gap: 6px; } form { gap: 12px; } footer { justify-content: flex-end; }\n@media (max-width: 600px) { #columns { grid-template-columns: 1fr; } .lane { min-height: 64px; } }\n</style></head>\n<body><main>\n  <header><div><h1>Task board</h1><p id=\"counts\" aria-live=\"polite\"></p></div><button id=\"add\" disabled>+ Add task</button></header>\n  <p id=\"notice\" role=\"status\"></p><div id=\"columns\" aria-label=\"Task board\"></div>\n</main>\n<dialog id=\"editor\"><form id=\"task-form\">\n  <h2 id=\"editor-title\">New task</h2>\n  <label>Task<input id=\"task-title\" maxlength=\"160\" required autocomplete=\"off\"></label>\n  <label>Notes<textarea id=\"notes\" rows=\"3\" maxlength=\"2000\"></textarea></label>\n  <label>Column<select id=\"stage\"></select></label>\n  <footer><button id=\"cancel\" type=\"button\">Cancel</button><button type=\"submit\">Save task</button></footer>\n</form></dialog>\n<script type=\"module\">const stages = ['To do', 'In progress', 'Done'];\nconst byId = id => document.getElementById(id);\nconst board = byId('columns'), editor = byId('editor'), add = byId('add');\nlet cards = [], revision = 0, editing = null, busy = true;\nconst element = (tag, text) => Object.assign(document.createElement(tag), { textContent: text });\nfunction button(text, click) {\n  const node = element('button', text);\n  node.type = 'button';\n  node.onclick = click;\n  return node;\n}\nfunction openEditor(card) {\n  editing = card?.id ?? null;\n  byId('editor-title').textContent = card ? 'Edit task' : 'New task';\n  byId('task-title').value = card?.title ?? '';\n  byId('notes').value = card?.notes ?? '';\n  byId('stage').value = card?.stage ?? stages[0];\n  editor.showModal();\n  byId('task-title').focus();\n}\nfunction render() {\n  board.replaceChildren();\n  add.disabled = busy;\n  board.inert = busy;\n  byId('counts').textContent = cards.length + (cards.length === 1 ? ' task' : ' tasks');\n  for (const stage of stages) {\n    const lane = element('section', ''), heading = element('div', '');\n    const subset = cards.filter(card => card.stage === stage);\n    lane.className = 'lane';\n    heading.className = 'lane-heading';\n    heading.append(element('h2', stage), element('span', String(subset.length)));\n    lane.append(heading);\n    lane.ondragover = event => event.preventDefault();\n    lane.ondrop = event => {\n      event.preventDefault();\n      const id = event.dataTransfer.getData('text/plain');\n      if (cards.some(c => c.id === id && c.stage !== stage)) void save(cards.map(c => c.id === id ? { ...c, stage } : c));\n    };\n    for (const card of subset) {\n      const article = element('article', ''), actions = element('div', '');\n      article.className = 'card';\n      article.draggable = true;\n      article.ondragstart = event => event.dataTransfer.setData('text/plain', card.id);\n      article.append(element('strong', card.title));\n      if (card.notes) article.append(element('p', card.notes));\n      actions.className = 'actions';\n      actions.append(button('Edit', () => openEditor(card)));\n      if (stage !== 'Done') {\n        const next = stages[stages.indexOf(stage) + 1];\n        actions.append(button('Move to ' + next, () => save(cards.map(c => c.id === card.id ? { ...c, stage: next } : c))));\n      }\n      const remove = button('Delete', () => {\n        actions.replaceChildren(button('Confirm delete', () => save(cards.filter(c => c.id !== card.id))), button('Cancel', render));\n      });\n      actions.append(remove);\n      article.append(actions);\n      lane.append(article);\n    }\n    if (!subset.length) lane.append(Object.assign(element('p', 'No tasks'), { className: 'empty' }));\n    board.append(lane);\n  }\n}\nasync function load() {\n  const response = await fetch('/state');\n  if (!response.ok) throw Error('Could not load the board. Reopen Kanban to retry.');\n  const snapshot = await response.json();\n  cards = snapshot.value?.cards ?? [];\n  revision = snapshot.revision;\n}\nasync function save(next) {\n  if (busy) return false;\n  busy = true;\n  render();\n  try {\n    const response = await fetch('/state', { method: 'PUT', headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ revision, value: { cards: next } }) });\n    if (response.status === 409) {\n      await load();\n      editor.close();\n      throw Error('The board changed in another window. Review the latest tasks and try again.');\n    }\n    if (!response.ok) throw Error('Could not save the board. Check the storage limit and try again.');\n    revision = (await response.json()).revision;\n    cards = next;\n    byId('notice').textContent = '';\n    return true;\n  } catch (error) { byId('notice').textContent = error.message; return false; }\n  finally { busy = false; render(); }\n}\nbyId('stage').append(...stages.map(stage => element('option', stage)));\nadd.onclick = () => openEditor(null);\nbyId('cancel').onclick = () => editor.close();\nbyId('task-form').onsubmit = async event => {\n  event.preventDefault();\n  const title = byId('task-title').value.trim();\n  if (!title) { byId('task-title').focus(); return; }\n  const card = { id: editing ?? crypto.randomUUID(), title, notes: byId('notes').value.trim(), stage: byId('stage').value };\n  if (await save(editing ? cards.map(c => c.id === editing ? card : c) : [...cards, card])) editor.close();\n};\ntry { await load(); busy = false; render(); }\ncatch (error) { byId('notice').textContent = error.message; }\n</script></body></html>\n"}
